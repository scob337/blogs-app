{
    "info": {
        "name": "Blog API Collection",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "description": "Routes for user authentication (Register, Login, Logout)",
            "item": [
                {
                    "name": "Register User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:3000/api/auth/register",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Login User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:3000/api/auth/login",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"john@example.com\",\n    \"password\": \"password123\"\n}"
                        }
                    }
                },
                {
                    "name": "Logout User",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "http://localhost:3000/api/auth/logout",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "logout"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Posts",
            "description": "Routes for creating, fetching, updating, and deleting posts",
            "item": [
                {
                    "name": "Create Post",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:3000/api/posts",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"My First Post\",\n    \"content\": \"This is the content of the post.\"\n}"
                        }
                    }
                },
                {
                    "name": "Get All Posts",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "http://localhost:3000/api/posts",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Single Post",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "http://localhost:3000/api/posts/{postId}",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts",
                                ":postId"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Post",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:3000/api/posts/{postId}",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts",
                                ":postId"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Updated Title\",\n    \"content\": \"Updated content.\"\n}"
                        }
                    }
                },
                {
                    "name": "Delete Post",
                    "request": {
                        "method": "DELETE",
                        "url": {
                            "raw": "http://localhost:3000/api/posts/{postId}",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts",
                                ":postId"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Likes",
            "description": "Routes for liking and unliking posts",
            "item": [
                {
                    "name": "Like/Unlike a Post",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "http://localhost:3000/api/posts/{postId}/like",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts",
                                ":postId",
                                "like"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Comments",
            "description": "Routes for adding and fetching comments on posts",
            "item": [
                {
                    "name": "Add Comment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "http://localhost:3000/api/posts/{postId}/comment",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts",
                                ":postId",
                                "comment"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"content\": \"This is a comment.\"\n}"
                        }
                    }
                },
                {
                    "name": "Get Comments",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "http://localhost:3000/api/posts/{postId}/comments",
                            "host": [
                                "localhost:3000"
                            ],
                            "path": [
                                "api",
                                "posts",
                                ":postId",
                                "comments"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}